      },
      {
        titre: 'Défi interface mobile',
        niveau: 'Intermédiaire',
        sommaire: 'Assembler une vue mobile claire avec une hiérarchie visuelle propre.'
      },
      {
        titre: 'Mini laboratoire DOM',
        niveau: 'Exploration',
        sommaire: 'Observer comment un gabarit HTML peut être cloné et injecté.'
      }
    ];

